# Variables de entorno del backend.
#
# Puerto donde escucha la API (por defecto 3100).
# El 3000 y 3001 suelen estar ocupados por otras herramientas en Windows, por
# eso el valor por defecto es 3100. El frontend usa esta misma URL en desarrollo.
PORT=3100

# Conexión a PostgreSQL.
#
# El puerto 2121 es el del contenedor de `docker-compose.yml`, elegido para no
# chocar con el PostgreSQL nativo de Windows (5432) ni con otros proyectos.
DATABASE_URL=postgresql://droopy:droopy@localhost:2121/droopy_manuel

# Token para escribir en /api/admin desde scripts o CI.
#
# Es opcional y distinto de las sesiones del panel: no identifica a nadie, así
# que la auditoría lo registra sin usuario. Debe tener al menos 16 caracteres;
# si está vacío o es corto, esa vía de acceso queda deshabilitada.
# ADMIN_TOKEN=cambia-esto-por-algo-largo-y-aleatorio

# Orígenes permitidos por CORS, separados por coma.
# En desarrollo el frontend de SvelteKit corre en el 5173, ya incluido por
# defecto. En producción añade aquí tu dominio real.
# PUBLIC_ORIGINS=https://droopymanuel.co,https://www.droopymanuel.co

# En producción activa la cookie de sesión como `secure` (solo HTTPS).
# NODE_ENV=production

# ---------------------------------------------------------------- Mercado Pago
# Access token de la aplicacion (Tus integraciones > Credenciales).
# Ojo: las credenciales de prueba nuevas tambien empiezan con APP_USR.
# El entorno lo define el selector "Prueba"/"Produccion" del panel, no el prefijo.
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...

# Moneda de la cuenta de Mercado Pago (ISO 4217). Colombia: COP.
# MERCADOPAGO_CURRENCY=COP

# URL publica del frontend: a donde vuelve la persona despues de pagar.
# Mercado Pago solo acepta URLs de retorno https. En local, sin un tunel
# https, no habra retorno automatico.
# En desarrollo: http://localhost:5173
# FRONTEND_URL=http://localhost:5173

# URL de retorno completa para una prueba puntual (debe ser https).
# Tiene prioridad sobre FRONTEND_URL y no se le agrega ningun path.
# Si se define, los tres estados vuelven a la misma URL.
# MERCADOPAGO_BACK_URL=https://www.youtube.com

# Retorno por estado (debe ser https). Sin estas variables los tres estados
# vuelven a la misma pagina: /dona-estrellas/estado, que lee el estado del pago
# guardado en la base y lo muestra. Si aun no existe, se ve como pendiente.
# MERCADOPAGO_BACK_URL_SUCCESS=https://www.droopymanuel.co/dona-estrellas/estado
# MERCADOPAGO_BACK_URL_PENDING=https://www.droopymanuel.co/dona-estrellas/estado
# MERCADOPAGO_BACK_URL_FAILURE=https://www.droopymanuel.co/dona-estrellas/estado

# URL publica del backend (https). Con ella se arma el webhook
# <SERVER_PUBLIC_URL>/api/donations/webhook, que guarda cada pago.
# En local no hay URL publica: sin tunel, Mercado Pago no puede avisar.
# SERVER_PUBLIC_URL=https://api.droopymanuel.co

# URL exacta del webhook, si no quieres derivarla de SERVER_PUBLIC_URL.
# MERCADOPAGO_NOTIFICATION_URL=https://api.droopymanuel.co/api/donations/webhook

# Secreto de firma del webhook (Tus integraciones > Webhooks).
# Si existe, las notificaciones deben traer una firma valida.
# MERCADOPAGO_WEBHOOK_SECRET=...

